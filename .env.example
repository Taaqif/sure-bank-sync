TZ=Australia/Melbourne
HOST_PORT=8686

# Encrypts bank logins / API keys stored in the database. Required.
# Generate: openssl rand -hex 32
# Back it up: without it, saved logins can't be read.
SURE_SYNC_SECRET_KEY=

# App log file size before it rotates (bytes). One previous file is kept. Default 5 MB.
# SURE_SYNC_LOG_MAX_BYTES=5000000

# --- web UI login (see docs/self-hosting.md) ---
# password | oidc | none. Unset: password if SURE_SYNC_ADMIN_PASSWORD is set,
# else oidc if SURE_SYNC_OIDC_ISSUER is set, else none (no login: only behind
# a proxy that requires one).
# SURE_SYNC_AUTH=password

# password mode (user "admin" unless SURE_SYNC_ADMIN_USER is set)
SURE_SYNC_ADMIN_PASSWORD=

# oidc mode (Pocket ID, Authelia, Authentik, Keycloak, Google, ...)
# Redirect URL to register: <SURE_SYNC_PUBLIC_URL>/auth/oidc/callback
# SURE_SYNC_OIDC_ISSUER=https://id.example.com
# SURE_SYNC_OIDC_CLIENT_ID=
# SURE_SYNC_OIDC_CLIENT_SECRET=          # empty for a public (PKCE) client
# SURE_SYNC_OIDC_NAME=Pocket ID          # sign-in button text
# SURE_SYNC_OIDC_ALLOWED_EMAILS=alice@example.com,bob@example.com
# SURE_SYNC_OIDC_ALLOWED_GROUPS=household
# SURE_SYNC_OIDC_GROUPS_CLAIM=groups
# SURE_SYNC_OIDC_SCOPES=openid email profile

# --- reverse proxy ---
# External URL (needed for OIDC redirects).
# SURE_SYNC_PUBLIC_URL=https://sync.example.com
# Trust X-Forwarded-For/-Proto/-Host. Only when the proxy is the only way in.
# SURE_SYNC_TRUST_PROXY=1

# --- development only ---
# SURE_SYNC_DEBUG=1            adds a "Debug run" button: dry run with a visible browser
#                              (needs a display, e.g. WSLg), network capture and kept downloads
# SURE_SYNC_SLOWMO=150         ms between browser actions in debug runs
# SURE_SYNC_PAUSE_ON_ERROR=1   debug runs open the Playwright Inspector on failure

# Normal runs use Chrome with a window on a virtual screen (Xvfb), because some
# banks (Amex) block windowless Chrome. Set to 1 to force headless instead.
# SURE_SYNC_HEADLESS=1
