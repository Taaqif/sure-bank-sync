TZ=Australia/Melbourne
HOST_PORT=8686

# Encrypts bank logins / API keys stored in the database. Required.
# Generate: docker compose run --rm sure-bank-sync --generate-key
# Back it up: without it, saved logins can't be read.
SURE_SYNC_SECRET_KEY=

# App log file size before it rotates (bytes). One previous file is kept. Default 5 MB.
# SURE_SYNC_LOG_MAX_BYTES=5000000

# Web UI login (user "admin" unless SURE_SYNC_ADMIN_USER is set). Strongly recommended.
SURE_SYNC_ADMIN_PASSWORD=

# --- development only ---
# SURE_SYNC_DEBUG=1            adds a "Debug run" button: dry run with a visible browser
#                              (needs a display, e.g. WSLg), network capture and kept downloads
# SURE_SYNC_SLOWMO=150         ms between browser actions in debug runs
# SURE_SYNC_PAUSE_ON_ERROR=1   debug runs open the Playwright Inspector on failure
