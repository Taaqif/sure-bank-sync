{
  "name": "sure-bank-sync",
  "version": "0.4.0",
  "description": "Scheduled bank transaction scraper that syncs into a self-hosted Sure instance",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "better-sqlite3": "^13.0.3",
    "croner": "^11.0.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "openid-client": "^6.8.9",
    "playwright": "1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "~4.0.0"
  }
}
